# Copy to .env.local. Never commit .env.local.
# Production uses the same names, set on Vercel's Production environment (see README, Deploy).

# Convex. `bunx convex dev` writes these for the dev deployment. In production, the build
# gets VITE_CONVEX_URL from `convex deploy`, which reads CONVEX_DEPLOY_KEY. That key lives
# only in Vercel (Production), never here.
CONVEX_DEPLOYMENT=
VITE_CONVEX_URL=

# Clerk. From the Clerk dashboard, API keys page: the dev instance here, the production
# instance on Vercel. The publishable key is built into the client; the secret stays on
# the server.
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Where Clerk sends people who need to sign in or up. The routes are catch-alls (src/routes/sign-in.$.tsx).
CLERK_SIGN_IN_URL=/sign-in
CLERK_SIGN_UP_URL=/sign-up

# The MCP door (src/routes/mcp.ts). One random value, here for the server route and on the
# Convex deployment for its agent functions; the two must match.
#   openssl rand -base64 32
#   bunx convex env set AGENT_SECRET <value>      (add --prod for production)
AGENT_SECRET=

# Set on the Convex deployment, not here: `bunx convex env set CLERK_JWT_ISSUER_DOMAIN https://<your-instance>.clerk.accounts.dev`

# 1 builds in the design gallery at /gallery (Vercel Preview and Development); otherwise it is not found.
VITE_GALLERY=1
