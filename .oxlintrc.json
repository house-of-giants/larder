{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "react", "jsx-a11y", "vitest"],
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": [
    "dist/**",
    "node_modules/**",
    ".output/**",
    ".nitro/**",
    ".vercel/**",
    "src/routeTree.gen.ts",
    "convex/_generated/**",
    "playwright-report/**",
    "test-results/**"
  ],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error"
  },
  "env": {
    "builtin": true,
    "browser": true,
    "node": true,
    "es2022": true
  }
}
